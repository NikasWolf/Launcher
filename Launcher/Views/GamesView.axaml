<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Launcher.Models"
             x:Class="Launcher.Views.GamesView"
             Background="#1E1E1E">

	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<ItemsControl x:Name="GamesItemsControl">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<WrapPanel/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate DataType="models:Game">
					<Border Width="464" Height="342" Background="#4A4949" CornerRadius="10" Margin="5">
						<StackPanel>

							<!-- ========== КАРТИНКИ ========== -->
							<DockPanel Height="230">

								<!-- МАЛЕНЬКИЕ КАРТИНКИ (справа) -->
								<Border DockPanel.Dock="Right" Width="80" Margin="5">
									<ScrollViewer VerticalScrollBarVisibility="Auto">
										<ItemsControl ItemsSource="{Binding LoadedImages}">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate>
													<StackPanel Spacing="5"/>
												</ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<Border CornerRadius="5" ClipToBounds="True" Height="40">
														<Button Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="0"
                                                                Click="SmallImage_Click"
                                                                Tag="{Binding}">
															<Image Source="{Binding}" Stretch="UniformToFill"/>
														</Button>
													</Border>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</ScrollViewer>
								</Border>

								<!-- БОЛЬШАЯ КАРТИНКА (слева) -->
								<Border CornerRadius="10,0,0,0"
                                        Background="#4A4949"
                                        ClipToBounds="True">
									<Image Source="{Binding MainImage}"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
								</Border>
							</DockPanel>

							<!-- ========== ТЕКСТ ========== -->
							<StackPanel Margin="10">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>

									<StackPanel Grid.Column="0" Orientation="Horizontal">
										<TextBlock Text="{Binding Name}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   TextWrapping="Wrap"/>
										<TextBlock Text="{Binding Condition}"
                                                   FontSize="12"
                                                   Foreground="White"
                                                   Margin="20,5,0,0"/>
									</StackPanel>

									<Button Grid.Column="1"
                                            Content="{Binding ButtonText}"
                                            Foreground="{Binding ButtonColor}"
                                            Background="#4C6B22"
                                            Click="OnAddToSelfClick"
                                            Tag="{Binding}"
                                            Margin="10,0,0,0"/>
								</Grid>

								<TextBlock FontSize="12" Foreground="#C8C8C8" Margin="0,5,0,0">
									<Run Text="{Binding Genre}"/>
									<Run Text=" Год релиза: "/>
									<Run Text="{Binding Year}"/>
								</TextBlock>

								<TextBlock Text="{Binding Description}"
                                           FontSize="11"
                                           Foreground="#C8C8C8"
                                           TextWrapping="Wrap"
                                           MaxHeight="50"/>
							</StackPanel>

						</StackPanel>
					</Border>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</ScrollViewer>
</UserControl>