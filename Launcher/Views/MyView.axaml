<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Launcher.Models"
             x:Class="Launcher.Views.MyView"
			 x:DataType="models:Game">

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="162"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- Левая панель (список) -->
		
		<ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Background="#4A4949">
			<StackPanel>

				<TextBlock Text="Мои игры" Foreground="White" Margin="5,10,5,5"/>

				<ItemsControl x:Name="UserGamesList" Margin="0,0,0,10">
					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="models:Game">
							<Button Content="{Binding Name}"
                                    Foreground="#C8C8C8"
                                    Background="Transparent"
                                    Width="162"
                                    Height="30"
                                    HorizontalContentAlignment="Left"
                                    Margin="5,2"
                                    Click="OnGameClick"
                                    Tag="{Binding}"/>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

			</StackPanel>
		</ScrollViewer>

		<!-- Правая панель (информация об игре) -->
		<Border Grid.Column="1" Background="#4A4949" Margin="10">
			<ScrollViewer VerticalScrollBarVisibility="Auto">
				<StackPanel x:Name="GameInfoPanel" Margin="20" IsVisible="False">

					<!-- Картинка -->
					<Border CornerRadius="10,0,0,0" Background="#4A4949" ClipToBounds="True" Height="251">
						<Image x:Name="GameImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>

					<!-- Название и кнопки -->
					<Grid Margin="0,10,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
							<!-- добавили колонку -->
						</Grid.ColumnDefinitions>

						<TextBlock x:Name="GameName" FontSize="24" FontWeight="Bold" Foreground="White" Grid.Column="0"/>

						<Button x:Name="InstallButton"
								Grid.Column="1"
								Padding="20,10"
								Margin="5,0"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								Click="OnInstallClick"/>

						<Button x:Name="DeleteButton"
								Content="Удалить игру"
								Foreground="#B85454"
								Background="#7C0505"
								Grid.Column="2"
								Padding="20,10"
								Margin="5,0"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								Click="OnDeleteClick"/>

						<Button x:Name="RemoveFromListButton"
								Content="Убрать из списка"
								Foreground="#C8C8C8"
								Background="#4A4949"
								Grid.Column="3"
								Padding="20,10"
								Margin="5,0"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								Click="OnRemoveFromListClick"/>
					</Grid>

					<!-- Остальные поля -->
					<TextBlock x:Name="GameGenre" FontSize="14" Foreground="#C8C8C8" Margin="0,10,0,0"/>
					<TextBlock x:Name="GameYear" FontSize="14" Foreground="#C8C8C8"/>
					<TextBlock x:Name="GameCondition" FontSize="14" Foreground="#C8C8C8"/>
					<TextBlock x:Name="GameDescription" FontSize="12" Foreground="#C8C8C8" TextWrapping="Wrap" Margin="0,10,0,0"/>

				</StackPanel>
			</ScrollViewer>
		</Border>

	</Grid>
</UserControl>