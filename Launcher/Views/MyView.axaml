
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Launcher.Models"
             x:Class="Launcher.Views.MyView"
			 x:DataType="models:Game">



	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="240"/>
			<ColumnDefinition Width="10"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- ================================Левая панель (список)  фон в ScrollViewer============================================-->

		<ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Background="#4A4949" > 
			<StackPanel>
				<TextBlock Text="Мои игры" Foreground="White" Margin="5,10,5,5"/>
				<ItemsControl x:Name="UserGamesList" Margin="0,0,0,10">
					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="models:Game">
							<StackPanel Orientation="Horizontal">
								<Button Background="Transparent"
											Height="30"
											HorizontalContentAlignment="Left"
										
											Click="OnGameClick"
											Tag="{Binding}">

									<StackPanel Orientation="Horizontal" Spacing="5">
										<!-- Иконка -->
										<Image Source="{Binding GameIcon}"
											   Width="20"
											   Height="20"
											   Stretch="UniformToFill"
											   VerticalAlignment="Center"/>

										<!-- Название игры -->
										<TextBlock Text="{Binding Name}"
												   Foreground="#C8C8C8"
												   VerticalAlignment="Center"
												   Width="120"
											   />
									</StackPanel>
								</Button>
								<Button x:Name="InstallButton"
										Content="{Binding InstallButtonText}"
										FontSize="10"
									
										MinHeight="21"
										HorizontalAlignment="Right"
										Click="OnMiniClick"
									
										Tag="{Binding}"/>
							</StackPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

			</StackPanel>
		</ScrollViewer>
		<Image Grid.Column="1"
		  Source="/Assets/Element/GradL.png"
		  Stretch="Fill"
		  VerticalAlignment="Stretch"/>
		
		<!-- =============Правая панель (информация об игре) фон в StackPanel x:Name======================================-->
		<Border Grid.Column="2"  Margin="10">
			
			<ScrollViewer VerticalScrollBarVisibility="Auto">
				<StackPanel x:Name="GameInfoPanel" Margin="20" IsVisible="False" Background="#4A4949">
					
					<!-- Картинка -->
					<Border CornerRadius="10,0,0,0" Background="#4A4949" ClipToBounds="True" Height="251">
						<Image x:Name="GameImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>

					<!-- Грид для выравнивания кнопок и текста -->
					<Grid Margin="0,10,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<!-- Название игры -->
						<TextBlock x:Name="GameName" FontSize="24" FontWeight="Bold" Foreground="White" Grid.Column="0"/>
						<!-- Скачать\запустить -->
						<Button x:Name="InstallButton"
								Grid.Column="1"
								Padding="20,10"
								Margin="5,0"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								Click="OnInstallClick"/>
						<!-- Удалить с устройства-->
						<Button x:Name="DeleteButton"
								Content="Удалить игру"
								Foreground="#B85454"
								Background="#7C0505"
								Grid.Column="2"
								Padding="20,10"
								Margin="5,0"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								Click="OnDeleteClick"/>
						<!-- убрать из списка -->
						<Button x:Name="RemoveFromListButton"
								Content="Убрать из списка"
								Foreground="#C8C8C8"
								Background="#4A4949"
								Grid.Column="3"
								Padding="20,10"
								Margin="5,0"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								Click="OnRemoveFromListClick"/>
					</Grid>

					<!-- Жанр -->
					<TextBlock x:Name="GameGenre" FontSize="14" Foreground="#C8C8C8" Margin="0,10,0,0"/>
					<!-- Год -->
					<TextBlock x:Name="GameYear" FontSize="14" Foreground="#C8C8C8"/>
					<!-- Статус -->
					<TextBlock x:Name="GameCondition" FontSize="14" Foreground="#C8C8C8"/>
					<!-- Разработчик -->
					<TextBlock x:Name="GameDeveloper" FontSize="14" Foreground="#C8C8C8"/>
					<!-- Описание -->
					<TextBlock x:Name="GameDescription" FontSize="12" Foreground="#C8C8C8" TextWrapping="Wrap" Margin="0,10,0,0"/>
					</StackPanel>
				
			</ScrollViewer>
		</Border>
	</Grid>
	
</UserControl>