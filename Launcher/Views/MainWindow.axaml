<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Launcher.Views"
        x:Class="Launcher.Views.MainWindow"
        Title="Launcher"
        Width="960" Height="577"
        CanResize="false"
        Background="#1E1E1E">

	<DockPanel>
		<!-- Верхняя панель -->
		<Border DockPanel.Dock="Top" Height="45" Background="#2B2B2B">
			<StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="10,0">
				<Button x:Name="MyButton"
                        Content="Моё"
                        Click="OnMyClick"
                        Foreground="#C8C8C8"
                        Background="Transparent"/>

				<Button x:Name="GamesButton"
                        Content="Игры"
                        Click="OnGamesClick"
                        Foreground="#C8C8C8"
                        Background="Transparent"/>
			</StackPanel>
		</Border>

		<!-- Здесь будет меняться содержимое -->
		<ContentControl x:Name="MainContent"/>
	</DockPanel>
</Window>